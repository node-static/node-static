{
  "name": "@node-static/node-static",
  "version": "0.9.0",
  "description": "simple, compliant file streaming module for node",
  "author": "Alexis Sellier <alexis@cloudhead.io>",
  "contributors": [
    "Pablo Cantero",
    "Ionică Bizău <bizauionica@gmail.com>",
    "Brett Zamir"
  ],
  "type": "module",
  "main": "./lib/node-static.js",
  "exports": {
    ".": {
      "types": "./dist/lib/node-static.d.ts",
      "import": "./lib/node-static.js",
      "require": "./dist/node-static.cjs"
    }
  },
  "license": "MIT",
  "bin": {
    "static": "bin/cli.js"
  },
  "keywords": [
    "http",
    "static",
    "file",
    "server"
  ],
  "repository": {
    "type": "git",
    "url": "http://github.com/node-static/node-static"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "tsc": "tsc",
    "gzip": "node test/gzip.js",
    "build": "rollup -c && tsc -p tsconfig-prod.json",
    "start": "./bin/cli.js",
    "lint": "eslint .",
    "mocha": "mocha test/integration --parallel",
    "test": "npm run gzip && c8 npm run mocha"
  },
  "dependencies": {
    "command-line-basics": "^3.0.0",
    "is-hidden-file": "^1.1.2",
    "mime": "^3.0.0",
    "minimatch": "^10.2.6",
    "picocolors": "^1.1.1"
  },
  "c8": {
    "check-coverage": true,
    "branches": 100,
    "functions": 100,
    "lines": 100,
    "statements": 100,
    "exclude": [
      "dist",
      "test"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/mime": "^3.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/node-fetch": "^2.6.13",
    "@types/node-gzip": "^1.1.3",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "mocha": "^11.7.6",
    "node-fetch": "^2.6.6",
    "rollup": "^4.62.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.0.0"
  },
  "bugs": {
    "url": "https://github.com/node-static/node-static/issues"
  },
  "homepage": "https://github.com/node-static/node-static",
  "directories": {
    "example": "examples",
    "test": "test"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "is-hidden-file@1.1.2": true
  }
}
